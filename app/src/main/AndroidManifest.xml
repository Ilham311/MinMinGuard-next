<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
            android:name=".MyApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/AppTheme">

        <activity
                android:name=".ui.MainActivity"
                android:label="@string/app_name"
                android:exported="true"
                android:configChanges="keyboardHidden|orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS"/>
            </intent-filter>
        </activity>

        <activity
                android:name=".ui.LauncherAliasActivity"
                android:label="@string/app_name"
                android:theme="@style/FullscreenTheme"
                android:exported="true"
                android:noHistory="true"
                android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
                android:name=".ui.MinMinGuardIntro"
                android:label="@string/app_name"
                android:exported="false"
                android:theme="@style/FullscreenTheme"/>

        <provider
                android:name=".MinMinProvider"
                android:authorities="tw.fatminmin.xposed.minminguard.next"
                android:enabled="true"
                android:exported="true"/>

        <meta-data
                android:name="xposedmodule"
                android:value="true"/>
        <!-- Dukungan preferensi lintas-proses: LSPosed >= 93 memakai
             XSharedPreferences "baru" bila xposedsharedprefs aktif; bridge
             lama memakai jalur berkas tetap. Keduanya ditangani BlockPrefs. -->
        <meta-data
                android:name="xposedminversion"
                android:value="82"/>
        <meta-data
                android:name="xposeddescription"
                android:value="Ads blocker"/>
        <meta-data
                android:name="xposedsharedprefs"
                android:value="true"/>
        <!-- Scope yang disarankan. Modul tidak lagi menyuntikkan izin ke proses
             "android", jadi paket sistem itu tidak perlu (dan tidak boleh)
             dimasukkan ke scope. -->
        <meta-data
                android:name="xposedscope"
                android:value="tw.fatminmin.xposed.minminguard.next"/>
    </application>
</manifest>
